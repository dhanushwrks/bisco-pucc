# ── Supabase (Project Settings → API Keys) ───────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...              # server-only, never expose
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Daily reminder job (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=generate-a-long-random-string

# ── WhatsApp Cloud API (leave blank to run reminders in simulation mode) ──
WHATSAPP_TOKEN=                  # permanent System User token
WHATSAPP_PHONE_NUMBER_ID=        # from WhatsApp → API Setup
WHATSAPP_APP_SECRET=             # App Settings → Basic (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=           # any string; paste the same in the webhook config
WHATSAPP_API_VERSION=v21.0
